# Set these through Replit Secrets for the running application.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/privacyguard_ai
SESSION_SECRET=replace-with-a-long-random-session-secret

# Optional Replit-managed Gemini integration variables take precedence.
# Otherwise, add a Google Gemini API key through Replit Secrets.
GEMINI_API_KEY=replace-with-your-gemini-api-key
